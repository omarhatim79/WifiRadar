<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- ── HEADER ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/black"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_filter_button"
            android:src="@drawable/ic_chevron_left"
            android:scaleType="center"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/feature_wifi_optimization"
            android:textAppearance="@style/TextAppearance.WifiRadar.H5.SemiBold"
            android:textColor="@color/white" />

        <LinearLayout
            android:id="@+id/btn_analyze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_rescan_button"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lightbulb"
                android:tint="@color/black"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/analyze"
                android:textAppearance="@style/TextAppearance.WifiRadar.OverlineSmall.SemiBold"
                android:textColor="@color/black" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── BOTTOM NAV ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="0.45"
                android:clickable="true"
                android:focusable="true">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@android:color/transparent" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_nav_home" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="@string/nav_home" android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.Medium" android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_capture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="0.45"
                android:clickable="true"
                android:focusable="true">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@android:color/transparent" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_nav_capture" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="@string/nav_capture" android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.Medium" android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_hidden"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="0.45"
                android:clickable="true"
                android:focusable="true">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@android:color/transparent" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_nav_hidden" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="@string/nav_hidden" android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.Medium" android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_security"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="0.45"
                android:clickable="true"
                android:focusable="true">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@android:color/transparent" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_nav_security" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="@string/nav_security" android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.Medium" android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_channel_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="0.45"
                android:clickable="true"
                android:focusable="true">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@android:color/transparent" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="10dp" android:src="@drawable/ic_star" android:tint="@color/white" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="@string/nav_rating" android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.Medium" android:textColor="@color/white" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── SCROLLABLE CONTENT ────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- ── Score Banner ───────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:background="@drawable/bg_content_panel">

                <ImageView
                    android:layout_width="218dp"
                    android:layout_height="114dp"
                    android:src="@drawable/ic_arc"
                    android:scaleType="fitCenter"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_score"
                        android:textAppearance="@style/TextAppearance.WifiRadar.H5.SemiBold"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/wifi_score_label"
                        android:textAppearance="@style/TextAppearance.WifiRadar.ParagraphSmall.Regular"
                        android:textColor="@color/zinc_500"
                        android:gravity="center" />
                </LinearLayout>

            </FrameLayout>

            <!-- ── Stats Panel ────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_panel"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <!-- High Priority row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_high_priority"
                        android:textAppearance="@style/TextAppearance.WifiRadar.OverlineSmall.SemiBold"
                        android:textColor="@color/zinc_600" />

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_count_chip">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2"
                            android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.SemiBold"
                            android:textColor="@color/destructive_400" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Recommendations row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_recommendations"
                        android:textAppearance="@style/TextAppearance.WifiRadar.OverlineSmall.SemiBold"
                        android:textColor="@color/zinc_600" />

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_count_chip">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="4"
                            android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.SemiBold"
                            android:textColor="@color/warning_500" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Applied row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_applied"
                        android:textAppearance="@style/TextAppearance.WifiRadar.OverlineSmall.SemiBold"
                        android:textColor="@color/zinc_600" />

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_count_chip">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1"
                            android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.SemiBold"
                            android:textColor="@color/success_400" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ── Recommendations Panel ──────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_panel"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <!-- OptCard 1: Switch to channel 11 — High Impact (red) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_opt_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_opt_icon">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_information_circle"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Switch to channel 11"
                            android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.SemiBold"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Channel 6 is congested. Moving to channel 11 will improve performance by 40%."
                        android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Regular"
                        android:textColor="@color/gray_500" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_destructive"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badge_high_impact"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.SemiBold"
                                android:textAllCaps="true"
                                android:textColor="@color/destructive_600" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_neutral"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginStart="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badge_channel"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.SemiBold"
                                android:textAllCaps="true"
                                android:textColor="@color/gray_600" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_ghost"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opt_learn_more"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Medium"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_white"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opt_apply_now"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Medium"
                                android:textColor="@color/black" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- OptCard 2: Switch to channel 12 — Moderate Impact (amber) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_opt_card"
                    android:padding="16dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_opt_icon">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_information_circle"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Switch to channel 12"
                            android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.SemiBold"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Channel 7 is experiencing interference. Transitioning to channel 12 can enhance stability by 35%."
                        android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Regular"
                        android:textColor="@color/gray_500" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_warning"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badge_moderate_impact"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.SemiBold"
                                android:textAllCaps="true"
                                android:textColor="@color/warning_500" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_neutral"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginStart="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badge_channel"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.SemiBold"
                                android:textAllCaps="true"
                                android:textColor="@color/gray_600" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_ghost"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opt_learn_more"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Medium"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_white"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opt_apply_now"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Medium"
                                android:textColor="@color/black" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- OptCard 3: Switch to channel 13 — Low Impact (green) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_opt_card"
                    android:padding="16dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_opt_icon">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_information_circle"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Switch to channel 13"
                            android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.SemiBold"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Channel 8 is saturated. Selecting channel 13 will reduce latency by 25%."
                        android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Regular"
                        android:textColor="@color/gray_500" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_success"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badge_low_impact"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.SemiBold"
                                android:textAllCaps="true"
                                android:textColor="@color/success_500" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_neutral"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginStart="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/badge_channel"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelXSmall.SemiBold"
                                android:textAllCaps="true"
                                android:textColor="@color/gray_600" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_ghost"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opt_learn_more"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Medium"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_button_white"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/opt_apply_now"
                                android:textAppearance="@style/TextAppearance.WifiRadar.LabelSmall.Medium"
                                android:textColor="@color/black" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
